[Desktop Entry]
Type=Application
Name=Blazer Studio
Comment=Laser-Workspace für den Blaze X M3 – erster Entwurf mit Simulator
Exec=/bin/bash "@PROJECT_SCRIPT@" %f
Icon=@PROJECT_ICON@
Terminal=false
Categories=Graphics;Engineering;
MimeType=application/x-blazer-studio;application/x-blazer-template;
StartupNotify=true
X-Blazer-Source=@PROJECT_SOURCE@
